{
  "name": "@yunzhen/request",
  "type": "module",
  "version": "1.1.0",
  "packageManager": "pnpm@11.20.0",
  "description": "基于 axios 封装的请求库",
  "homepage": "https://github.com/yunzhencc/request/issues#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunzhencc/request.git"
  },
  "bugs": {
    "url": "https://github.com/yunzhencc/request/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "pnpm build && vitest",
    "release": "semantic-release --no-ci",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "axios": "catalog:core",
    "es-toolkit": "catalog:core",
    "qs": "catalog:core"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@commitlint/cli": "catalog:cli",
    "@commitlint/config-conventional": "catalog:cli",
    "@commitlint/types": "catalog:cli",
    "@semantic-release/changelog": "catalog:cli",
    "@semantic-release/git": "catalog:cli",
    "@types/node": "catalog:types",
    "@types/qs": "catalog:types",
    "axios-mock-adapter": "catalog:test",
    "eslint": "catalog:cli",
    "lint-staged": "catalog:cli",
    "publint": "catalog:cli",
    "semantic-release": "catalog:cli",
    "simple-git-hooks": "catalog:cli",
    "tsdown": "catalog:cli",
    "typescript": "catalog:cli",
    "vitest": "catalog:test"
  },
  "simple-git-hooks": {
    "commit-msg": "npx --no -- commitlint --edit $1",
    "pre-commit": "npx lint-staged",
    "preserveUnused": [
      "commit-msg"
    ]
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "publishConfig": {
    "access": "public"
  }
}
