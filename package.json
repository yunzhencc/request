{
  "name": "@yunzhen/request",
  "type": "module",
  "version": "1.1.0",
  "packageManager": "pnpm@11.16.0",
  "description": "基于 axios 封装的请求库",
  "homepage": "https://github.com/yunzhencc/request/issues#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunzhencc/request.git"
  },
  "bugs": {
    "url": "https://github.com/yunzhencc/request/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "pnpm build && vitest",
    "release": "semantic-release --no-ci",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "es-toolkit": "^1.49.0",
    "qs": "^6.15.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.0",
    "@types/node": "^26.1.1",
    "@types/qs": "^6.15.1",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^10.7.0",
    "lint-staged": "^17.1.1",
    "publint": "^0.3.21",
    "semantic-release": "^25.0.8",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.22.13",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "simple-git-hooks": {
    "commit-msg": "npx --no -- commitlint --edit $1",
    "pre-commit": "npx lint-staged",
    "preserveUnused": [
      "commit-msg"
    ]
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "publishConfig": {
    "access": "public"
  }
}
