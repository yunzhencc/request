{
  "name": "@yunzhen/request",
  "type": "module",
  "version": "2.1.0",
  "packageManager": "pnpm@11.20.0",
  "description": "基于 axios 封装的请求库",
  "author": "YunZhen",
  "license": "MIT",
  "homepage": "https://github.com/yunzhencc/request#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunzhencc/request.git"
  },
  "bugs": "https://github.com/yunzhencc/request/issues",
  "keywords": [
    "axios",
    "request"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint",
    "prepack": "nr build",
    "release": "bumpp",
    "test": "pnpm run build && vitest",
    "typecheck": "tsc",
    "prepare": "git config core.hooksPath .githooks && simple-git-hooks && skills-npm"
  },
  "scripts-info": {
    "build": "Build the library for publishing",
    "dev": "Rebuild on change during development",
    "lint": "Check for code style issues",
    "prepack": "Build before publishing",
    "release": "Bump version and publish a release",
    "test": "Run the test suite",
    "typecheck": "Check types",
    "prepare": "Set up git hooks and skills"
  },
  "dependencies": {
    "axios": "catalog:core",
    "es-toolkit": "catalog:core",
    "qs": "catalog:core"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@antfu/ni": "catalog:cli",
    "@commitlint/cli": "catalog:cli",
    "@commitlint/config-conventional": "catalog:cli",
    "@commitlint/types": "catalog:cli",
    "@types/node": "catalog:types",
    "@types/qs": "catalog:types",
    "axios-mock-adapter": "catalog:testing",
    "bumpp": "catalog:cli",
    "eslint": "catalog:cli",
    "nano-staged": "catalog:cli",
    "publint": "catalog:cli",
    "simple-git-hooks": "catalog:cli",
    "skills-npm": "catalog:cli",
    "tsdown": "catalog:cli",
    "tsdown-stale-guard": "catalog:testing",
    "tsnapi": "catalog:testing",
    "tsx": "catalog:cli",
    "typescript": "catalog:cli",
    "vite": "catalog:cli",
    "vitest": "catalog:testing"
  },
  "simple-git-hooks": {
    "commit-msg": "npx --no -- commitlint --edit $1",
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && pnpm run build && npx nano-staged",
    "preserveUnused": [
      "commit-msg"
    ]
  },
  "nano-staged": {
    "*": "eslint --fix"
  },
  "publishConfig": {
    "access": "public"
  }
}
